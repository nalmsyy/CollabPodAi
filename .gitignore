# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
.dev-server.log
.pod-server.log
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local solid pod data
/.data/
/data/pod-server/

# generated from pdfjs-dist oleh scripts/copy-pdf-worker.mjs
/public/pdf.worker.min.mjs

# typescript
*.tsbuildinfo
next-env.d.ts
